# ---------------------------------------------------------------------------
# Job System — example environment. Copy to .env and adjust. NEVER commit .env.
# Safe defaults: DRY_RUN=true, AUTO_APPLY_ENABLED=false.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Database / queue
DATABASE_URL=postgres://job:job@localhost:5432/job_system
REDIS_URL=redis://localhost:6379

# API (bind to localhost by default; use 0.0.0.0 only inside containers)
API_HOST=127.0.0.1
API_PORT=3001

# Auth (single-user). AUTH_PASSWORD_HASH = sha256 hex of the password.
# Generate with: pnpm --filter @job-system/api hash-password "your-password"
AUTH_PASSWORD_HASH=change-me-sha256-hex
AUTH_SECRET=change-me-random-32-bytes
AUTH_COOKIE_SECURE=false

# Safety ceilings (never relaxed by DB settings/policies)
DRY_RUN=true
AUTO_APPLY_ENABLED=false

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.data/storage

# Logging
LOG_LEVEL=info

# AI: text generation and embeddings are INDEPENDENT ports.
# AI_PROVIDER drives future text generation; EMBEDDING_PROVIDER drives Phase 3
# matching. A chat provider does NOT imply an embeddings provider.
AI_PROVIDER=mock
DECISION_PROVIDER=mock
AI_MONTHLY_BUDGET_USD=20

# Embeddings (mock keeps CI/dev fully offline; openai is the only real one)
EMBEDDING_PROVIDER=mock
# EMBEDDING_MODEL=text-embedding-3-small   # required when EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SPACE_VERSION=v1
# EMBEDDING_API_KEY=...                    # preferred for openai; falls back to OPENAI_API_KEY
# OPENAI_API_KEY=...
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# Phase 2 — discovery
DEDUP_L3_HIGH_THRESHOLD=0.92
DEDUP_L3_MEDIUM_THRESHOLD=0.75
WATCHDOG_TIMEOUT_MS=900000
SCHEDULER_ENABLED=true
TARGET_ENRICHMENT_MAX_PER_RUN=25

# Web
API_URL=http://localhost:3001