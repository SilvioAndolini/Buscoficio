{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "TEST_DATABASE_URL", "TEST_REDIS_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["//#arch:check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#arch:check": {
      "cache": false,
      "inputs": ["scripts/**", "packages/*/src/**", "apps/*/src/**"]
    }
  }
}